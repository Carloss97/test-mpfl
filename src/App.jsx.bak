import React, { useCallback, useEffect, useMemo, useRef, useState } from 'react';
import { buildCameraConstraints, normalizeVideoInputDevices } from './telemetry/cameraDevices.js';
import { buildGestureInsights, AU_MAP, AU_REGIONS, GROUP_LABELS } from './telemetry/gestureInsights.js';
import { computeEnhancedAUs, setAUBaseline, resetAUCache } from './telemetry/auEnhancer.js';
import { setEmotionBaseline } from './telemetry/basicEmotions.js';
import { useFaceLandmarkerWorker } from './telemetry/useFaceLandmarkerWorker.js';
import { buildFusionPayload } from './telemetry/payload.js';
import { buildCalibrationProfile } from './telemetry/microgestureFeatures.js';
import { requestCameraWithFallback, stopStream } from './telemetry/adaptiveCapture.js';
import { adaptiveCalibrationSamples, estimateLightingQuality, canCalibrate } from './telemetry/lightingAdapter.js';
import { usePipelineWorker } from './telemetry/usePipelineWorker.js';
import FaceMeshOverlay from './telemetry/FaceMeshOverlay.jsx';
import Dashboard from './components/Dashboard.jsx';
import StickyHeader from './components/StickyHeader.jsx';
import SimpleRTTask from './tasks/SimpleRTTask.jsx';
import { generateReport, hasEnoughSamples } from './telemetry/reportGenerator.js';
import { getRecommendedConfig } from './telemetry/deviceCapabilities.js';
import { saveSession, loadSessions, clearSessions } from './telemetry/sessionStore.js';
import './styles.css';
import './dashboard.css';
import './dashboard-ux.css';
import './dashboard-v2.css';
import './sticky.css';
const MAX_SAMPLES = 900;
const RECENT_SAMPLE_WINDOW = 120;
const CALIBRATION_DURATION_MS = 4000;
const DEVICE_CONFIG = (() => {
try { return getRecommendedConfig(); } catch { return null; }
})();
function formatNumber(value, digits = 3) {
if (!Number.isFinite(value)) return Number(0).toFixed(digits);
return Number(value).toFixed(digits);
}
function clamp(value, min = 0, max = 1) {
if (!Number.isFinite(value)) return min;
return Math.min(max, Math.max(min, value));
}
function formatPercent(value) {
return `${Math.round(clamp(value) * 100)}%`;
}
const REGION_COLORS = {
upper: 'var(--ink-blue)',
mid: 'var(--ink-yellow)',
lower: 'var(--ink-green)',
};
const CHANNEL_COLORS = {
cognitiveLoad: 'var(--ink-yellow)',
emotionalRegulation: 'var(--ink-green)',
motorControl: 'var(--ink-blue)',
engagement: 'var(--ink-green)',
stressResilience: 'var(--ink-blue)',
fatigueIndex: 'var(--ink-red)',
};
export default function App() {
const videoRef = useRef(null);
const streamRef = useRef(null);
const faceSamplesRef = useRef([]);
const sessionStartRef = useRef(null);
const calibrationTimerRef = useRef(null);
const [isCameraActive, setCameraActive] = useState(false);
const [cameraError, setCameraError] = useState(null);
const [cameraDevices, setCameraDevices] = useState([]);
const [selectedDeviceId, setSelectedDeviceId] = useState('');
const [latestFaceSample, setLatestFaceSample] = useState(null);
const [latestLandmarks, setLatestLandmarks] = useState(null);
const [showMesh, setShowMesh] = useState(true);
const [blendshapeNames, setBlendshapeNames] = useState([]);
const [activeTab, setActiveTab] = useState('au');
const [sessions, setSessions] = useState(() => loadSessions());
const [exportStatus, setExportStatus] = useState(null);
const [calibrationProfile, setCalibrationProfile] = useState(null);
const [isCalibrating, setIsCalibrating] = useState(false);
const [reportContent, setReportContent] = useState(null);
const [showReport, setShowReport] = useState(false);
const [showReportModal, setShowReportModal] = useState(false);
const [taskActive, setTaskActive] = useState(false);
const taskEventsRef = useRef([]);
  const [taskEventCount, setTaskEventCount] = useState(0);
const recordFaceSample = useCallback((sample, landmarks) => {
faceSamplesRef.current = [...faceSamplesRef.current, sample].slice(-MAX_SAMPLES);
setLatestFaceSample(sample);
if (landmarks) setLatestLandmarks(landmarks);
const names = Object.keys(sample?.blendshapes ?? {});
if (names.length) {
setBlendshapeNames((prev) => {
const next = new Set(prev);
let changed = false;
for (const name of names) {
if (!next.has(name)) { next.add(name); changed = true; }
}
if (!changed) return prev;
return Array.from(next).sort();
});
}
}, []);
const faceWorker = useFaceLandmarkerWorker({
videoRef,
active: isCameraActive,
onSample: recordFaceSample,
fps: DEVICE_CONFIG?.fpsTarget ?? 15,
preferredDelegate: DEVICE_CONFIG?.mediapipeDelegate ?? 'GPU',
});
const refreshCameraDevices = useCallback(async () => {
if (!navigator.mediaDevices?.enumerateDevices) { setCameraDevices([]); return []; }
const devices = normalizeVideoInputDevices(await navigator.mediaDevices.enumerateDevices());
setCameraDevices(devices);
return devices;
}, []);
useEffect(() => { refreshCameraDevices().catch(() => setCameraDevices([])); }, [refreshCameraDevices]);
const attachCameraStream = useCallback(async (stream) => {
streamRef.current?.getTracks().forEach((t) => t.stop());
streamRef.current = stream;
if (videoRef.current) { videoRef.current.srcObject = stream; await videoRef.current.play(); }
}, []);
const buildSessionPayload = useCallback(() => {
const samples = faceSamplesRef.current;
if (!samples.length) { setExportStatus('error-no-data'); setTimeout(() => setExportStatus(null), 3000); return null; }
const now = performance.now();
const start = sessionStartRef.current ?? samples[0]?.timestamp ?? now - 1000;
return buildFusionPayload({
runId: crypto.randomUUID?.() ?? `${now}`,
startedAt: start, endedAt: now,
faceSamples: samples, calibrationProfile,
runtime: { userAgent: navigator.userAgent, platform: navigator.platform },
});
}, [calibrationProfile]);
const downloadBlob = useCallback((content, filename, mimeType = 'application/json') => {
const blob = new Blob([content], { type: mimeType });
const url = URL.createObjectURL(blob);
const a = document.createElement('a');
a.href = url; a.download = filename;
document.body.appendChild(a); a.click(); document.body.removeChild(a);
URL.revokeObjectURL(url);
}, []);
const downloadJson = useCallback((payload, filename) => {
downloadBlob(JSON.stringify(payload, null, 2), filename, 'application/json');
}, [downloadBlob]);
const handleExportSession = useCallback(() => {
const payload = buildSessionPayload();
if (!payload) return;
downloadJson(payload, `krumm-session-${new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19)}.json`);
setExportStatus('exported');
setTimeout(() => setExportStatus(null), 3000);
}, [buildSessionPayload, downloadJson]);
const handleTaskStart = useCallback((event) => {
taskEventsRef.current = [...taskEventsRef.current, event];
}, []);
const handleTaskEnd = useCallback((event) => {
taskEventsRef.current = [...taskEventsRef.current, event];
}, []);
const handleTaskComplete = useCallback((summary) => {
// Task finished — results are in summary
}, []);
const startTask = useCallback(() => {
    taskEventsRef.current = [];
    setTaskActive(true);
    // Scroll to task area after render
    setTimeout(() => {
      const el = document.querySelector('.simple-rt-task');
      el?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 100);
  }, []);
const handleSaveSession = useCallback(() => {
const payload = buildSessionPayload();
if (!payload) return;
saveSession(payload);
setSessions(loadSessions());
setExportStatus('saved');
setTimeout(() => setExportStatus(null), 3000);
}, [buildSessionPayload]);
const startCalibration = useCallback(() => {
    setIsCalibrating(true);
    setCalibrationProfile(null);
    const light = estimateLightingQuality(faceSamplesRef.current);
    const adapt = adaptiveCalibrationSamples(light);
    const duration = adapt.durationMs;
    calibrationTimerRef.current = setTimeout(() => {
      const samples = faceSamplesRef.current;
      const check = canCalibrate(samples, { minSamples: adapt.minSamples, minPresenceRatio: 0.2, minConfidence: 0.3 });
      if (!check.eligible) {
        setCalibrationProfile({ eligible: false, caveats: [check.reason], usableSampleCount: samples.length });
        setIsCalibrating(false);
        return;
      }
      // Use actual sample timestamps, not sessionStartRef, to guarantee window match
      const actualSamples = samples.filter((s) => s?.quality?.facePresent);
      const firstTs = actualSamples[0]?.timestamp ?? samples[0]?.timestamp ?? performance.now();
      const lastTs = samples[samples.length - 1]?.timestamp ?? firstTs + duration;
      const profile = buildCalibrationProfile(samples, { from: firstTs, to: lastTs });
      setCalibrationProfile(profile);
      if (profile.eligible) { setAUBaseline(profile, computeEnhancedAUs(samples)); setEmotionBaseline(profile.auBaseline ?? {}); }
      setIsCalibrating(false);
    }, duration);
  }, []);

    const cancelCalibration = useCallback(() => {
      if (calibrationTimerRef.current) { clearTimeout(calibrationTimerRef.current); calibrationTimerRef.current = null; }
      setIsCalibrating(false);
    }, []);
useEffect(() => () => { if (calibrationTimerRef.current) clearTimeout(calibrationTimerRef.current); }, []);
const startCamera = useCallback(async () => {
setCameraError(null);
try {
if (!navigator.mediaDevices?.getUserMedia) throw new Error('getUserMedia no disponible.');
const stream = await navigator.mediaDevices.getUserMedia(buildCameraConstraints(selectedDeviceId));
await attachCameraStream(stream);
await refreshCameraDevices().catch(() => []);
faceSamplesRef.current = [];
      resetAUCache();
sessionStartRef.current = performance.now();
setCalibrationProfile(null);
setIsCalibrating(false);
setShowReport(false);
setReportContent(null);
setShowReportModal(false);
setLatestFaceSample(null);
setLatestLandmarks(null);
setBlendshapeNames([]);
setCameraActive(true);
} catch (error) { setCameraError(error?.message ?? String(error)); }
}, [attachCameraStream, refreshCameraDevices, selectedDeviceId]);
const switchCamera = useCallback(async () => {
setCameraError(null);
try {
const stream = await navigator.mediaDevices.getUserMedia(buildCameraConstraints(selectedDeviceId));
await attachCameraStream(stream);
await refreshCameraDevices().catch(() => []);
setCameraActive(true);
} catch (error) { setCameraError(error?.message ?? String(error)); }
}, [attachCameraStream, refreshCameraDevices, selectedDeviceId]);
const stopCamera = useCallback(() => {
cancelCalibration();
const samples = faceSamplesRef.current;
if (samples.length > 0) {
const now = performance.now();
const start = sessionStartRef.current ?? samples[0]?.timestamp ?? now - 1000;
const payload = buildFusionPayload({
runId: crypto.randomUUID?.() ?? `${now}`,
startedAt: start, endedAt: now,
faceSamples: samples, calibrationProfile,
runtime: { userAgent: navigator.userAgent, platform: navigator.platform },
});
saveSession(payload);
setSessions(loadSessions());
}
streamRef.current?.getTracks().forEach((t) => t.stop());
streamRef.current = null;
setCameraActive(false);
sessionStartRef.current = null;
setCalibrationProfile(null);
}, [cancelCalibration, calibrationProfile]);
useEffect(() => () => { streamRef.current?.getTracks().forEach((t) => t.stop()); }, []);
const telemetry = useMemo(() => {
const allSamples = faceSamplesRef.current;
const recentSamples = allSamples.slice(-RECENT_SAMPLE_WINDOW);
const recentCount = recentSamples.length;
const presentCount = recentSamples.filter((s) => s?.quality?.facePresent).length;
const confidenceSum = recentSamples.reduce((s, sm) => s + Number(sm?.quality?.confidence ?? 0), 0);
const meanConfidence = recentCount ? confidenceSum / recentCount : 0;
const facePresenceRatio = recentCount ? presentCount / recentCount : 0;
let fpsEstimate = 0;
if (recentCount >= 2) {
const d = Number(recentSamples[recentCount - 1]?.timestamp ?? 0) - Number(recentSamples[0]?.timestamp ?? 0);
if (d > 0) fpsEstimate = ((recentCount - 1) / d) * 1000;
}
const insights = buildGestureInsights(recentSamples);
    if (recentCount > 0) {
      const enhanced = computeEnhancedAUs(recentSamples);
      insights.enhancedAUs = enhanced;
    }
return { sampleCount: allSamples.length, recentCount, facePresenceRatio, meanConfidence, fpsEstimate, insights };
}, [latestFaceSample]);

  // ─── Pipeline Worker (unified: features → AUs → edge AI → ML) ───
  const pipeline = usePipelineWorker({
    enabled: isCameraActive && (faceSamplesRef.current.length >= 2),
    faceSamples: faceSamplesRef.current,
    pointerSamples: [],
    taskEvents: taskEventsRef.current,
    calibrationProfile,
    debounceMs: 500,
  });

  const edgeAIResult = pipeline.result;
  const edgeChannels = edgeAIResult?.channels ?? {};
  const edgeConfidence = edgeAIResult?.confidence;
  const edgeComposite = edgeAIResult?.composite;

  const handleGenerateReport = useCallback((format = 'markdown') => {
if (!hasEnoughSamples(telemetry)) return;
const durationMs = performance.now() - (sessionStartRef.current ?? performance.now());
const report = generateReport({
telemetry, edgeAIResult, calibrationProfile,
sessionInfo: { runId: sessionStartRef.current ? `${sessionStartRef.current}` : null, durationMs, durationSeconds: durationMs / 1000 },
format,
});
if (format === 'json') { downloadBlob(report, `krumm-report-${new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19)}.json`, 'application/json'); return; }
if (format === 'html') { downloadBlob(report, `krumm-report-${new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19)}.html`, 'text/html'); return; }
setReportContent(report);
setShowReport(true);
setShowReportModal(true);
}, [telemetry, edgeAIResult, calibrationProfile, downloadBlob]);
const closeReportModal = useCallback(() => { setShowReportModal(false); }, []);
const downloadMarkdownReport = useCallback(() => {
if (reportContent) downloadBlob(reportContent, `krumm-report-${new Date().toISOString().replace(/[:.]/g, '-').slice(0, 19)}.md`, 'text/markdown');
}, [reportContent, downloadBlob]);
const statusClassName = faceWorker.status === 'ready' ? 'ready' : faceWorker.status === 'error' ? 'error' : '';
const lastQuality = latestFaceSample?.quality;
const insightItems = [
{ id: 'frustrationTolerance', label: 'Tolerancia a frustración', value: telemetry.insights.frustrationTolerance, description: 'Inversa de tensión (proxy).' },
{ id: 'tension', label: 'Tensión', value: telemetry.insights.tension, description: 'Ceja/ojos/mandíbula/presión labial.' },
{ id: 'attention', label: 'Atención', value: telemetry.insights.attention, description: 'Ojos abiertos + cejas; penaliza parpadeo.' },
{ id: 'surprise', label: 'Sorpresa', value: telemetry.insights.surprise, description: 'Ojos abiertos + cejas + mandíbula.' },
{ id: 'fatigue', label: 'Fatiga', value: telemetry.insights.fatigue, description: 'Parpadeo/squint alto; ojos menos abiertos.' },
{ id: 'stress', label: 'Estrés', value: telemetry.insights.stress, description: 'Tensión + presión labial + nariz.' },
{ id: 'calmness', label: 'Calma', value: telemetry.insights.calmness, description: 'Inversa de tensión/sorpresa.' },
{ id: 'engagement', label: 'Engagement', value: telemetry.insights.engagement, description: 'Atención + sonrisa, penaliza fatiga.' },
{ id: 'boredom', label: 'Aburrimiento', value: telemetry.insights.boredom, description: 'Atención baja + parpadeo.' },
{ id: 'confusion', label: 'Confusión', value: telemetry.insights.confusion, description: 'Cejas + boca abierta/estirada.' },
{ id: 'cognitiveLoad', label: 'Carga cognitiva', value: telemetry.insights.cognitiveLoad, description: 'Tensión sostenida en cejas/ojos/mandíbula.' },
];
const auScores = telemetry.insights.auScores ?? {};
const auRegionSummary = telemetry.insights.auRegionSummary ?? {};
const microgestureGroups = telemetry.insights.microgestureGroups ?? {};
const auEntries = Object.entries(auScores).filter(([, au]) => au.intensity > 0.01 || !au.note).sort((a, b) => b[1].intensity - a[1].intensity);
const mgEntries = Object.entries(microgestureGroups);
const activeAUCount = Object.values(auScores).filter((au) => au.intensity > 0.01).length;
const calStatusLabel = isCalibrating ? `Calibrando... ${CALIBRATION_DURATION_MS / 1000}s`
: calibrationProfile ? `Baseline: ${calibrationProfile.eligible ? 'válido' : 'inválido'}` : 'Sin calibrar';
const exportButtonText = exportStatus === 'exported' ? '✓ Exportado' : exportStatus === 'error-no-data' ? 'Sin datos' : 'Exportar sesión JSON';
const saveButtonText = exportStatus === 'saved' ? '✓ Guardado' : exportStatus === 'error-no-data' ? 'Sin datos' : 'Guardar sesión';
const canGenerateReport = hasEnoughSamples(telemetry) && (isCameraActive || telemetry.sampleCount > 0);
const reportMenuItems = canGenerateReport ? [
{ label: 'Reporte Markdown', format: 'markdown', icon: '📝', style: { background: 'var(--ink-green)', color: '#06121f', boxShadow: '0 12px 30px rgba(77,212,172,0.25)' } },
{ label: 'Reporte HTML', format: 'html', icon: '🌐', style: { background: 'var(--ink-blue)', color: '#06121f', boxShadow: '0 12px 30px rgba(116,167,255,0.25)' } },
{ label: 'Reporte JSON', format: 'json', icon: '📊', style: { background: 'var(--ink-yellow)', color: '#06121f', boxShadow: '0 12px 30px rgba(255,209,102,0.25)' } },
] : [];
return (
<main className="app-shell">
{showReportModal && reportContent && (
<div className="report-modal-overlay" onClick={closeReportModal}>
<div className="report-modal" onClick={(e) => e.stopPropagation()}>
<div className="report-modal-header">
<h2>📋 Reporte de Sesión</h2>
<div className="report-modal-actions">
<button type="button" className="secondary" onClick={downloadMarkdownReport} style={{ fontSize: '0.78rem' }}>Descargar .md</button>
<button type="button" className="secondary" onClick={closeReportModal} style={{ fontSize: '0.78rem' }}>Cerrar</button>
</div>
</div>
<div className="report-modal-body">
<pre className="report-content">{reportContent}</pre>
</div>
</div>
</div>
)}
{isCameraActive && (
        <StickyHeader
          edgeComposite={edgeComposite}
          edgeConfidence={edgeConfidence}
          auEntries={auEntries}
          topChannels={Object.entries(edgeChannels).sort((a,b) => b[1].score - a[1].score).slice(0,1)}
          calibrationProfile={calibrationProfile}
          calStatusLabel={calStatusLabel}
          telemetry={telemetry}
          faceWorker={faceWorker}
          emotions={edgeAIResult?.emotions}
          captureQuality={edgeAIResult?.confidence?.captureQuality}
        />
      )}
      <section className="hero-card">
<p className="eyebrow">Telemetría en tiempo real</p>
<h1>MediaPipe Face Landmarker</h1>
<p>Solo cámara y métricas en vivo en navegador. Las señales se procesan localmente con MediaPipe.</p>
<p className="privacy-note">Privacidad: no se almacena video ni frames; solo telemetría en memoria para visualización.</p>
<div className="camera-controls">
<label htmlFor="camera-device-select">Cámara</label>
<select id="camera-device-select" value={selectedDeviceId} onChange={(e) => setSelectedDeviceId(e.target.value)}>
<option value="">Automática / predeterminada</option>
{cameraDevices.map((d) => <option key={d.deviceId || d.label} value={d.deviceId}>{d.label}</option>)}
</select>
<button type="button" className="secondary" onClick={refreshCameraDevices}>Actualizar cámaras</button>
</div>
<div className="actions">
<button type="button" onClick={startCamera} disabled={isCameraActive}>Iniciar cámara</button>
<button type="button" className="secondary" onClick={switchCamera} disabled={!isCameraActive}>Cambiar cámara</button>
<button type="button" className="secondary" onClick={stopCamera} disabled={!isCameraActive}>Detener</button>
<button type="button" onClick={isCalibrating ? cancelCalibration : startCalibration}
disabled={!isCameraActive || telemetry.sampleCount < 10}
style={{ background: 'var(--ink-green)', color: '#06121f', boxShadow: '0 12px 30px rgba(77,212,172,0.25)' }}>
{isCalibrating ? 'Cancelar calibración' : 'Calibrar baseline'}
</button>
<button type="button" onClick={handleSaveSession} disabled={!telemetry.sampleCount}
style={{ background: 'var(--ink-blue)', color: '#06121f', boxShadow: '0 12px 30px rgba(116,167,255,0.25)' }}>
{saveButtonText}
</button>
<button type="button" onClick={handleExportSession} disabled={!telemetry.sampleCount}
style={{ background: 'var(--ink-yellow)', color: '#06121f', boxShadow: '0 12px 30px rgba(255,209,102,0.25)' }}>
{exportButtonText}
</button>
<button type="button" onClick={startTask} disabled={taskActive || !isCameraActive}
style={{ background: 'var(--ink-yellow)', color: '#06121f', boxShadow: '0 12px 30px rgba(255,209,102,0.25)' }}>
🎯 Tarea RT Simple
</button>
{reportMenuItems.map((item) => (
<button key={item.format} type="button" onClick={() => handleGenerateReport(item.format)} style={item.style}>
{item.icon} {item.label}
</button>
))}
</div>
{canGenerateReport && <p className="caption" style={{ marginTop: '10px', color: '#9fb0c2' }}>{telemetry.sampleCount} muestras — suficiente para generar reporte.</p>}
{!canGenerateReport && telemetry.sampleCount > 0 && <p className="caption" style={{ marginTop: '10px', color: 'var(--ink-yellow)' }}>{telemetry.sampleCount} muestras — se necesitan ≥20.</p>}
{isCalibrating && <p className="caption" style={{ marginTop: '10px', color: 'var(--ink-green)', fontWeight: 700 }}>Calibrando baseline — mantén expresión neutra {CALIBRATION_DURATION_MS / 1000}s...</p>}
{calibrationProfile && !isCalibrating && (
<p className="caption" style={{ marginTop: '10px', color: calibrationProfile.eligible ? 'var(--ink-green)' : 'var(--ink-red)', fontWeight: 700 }}>
{calibrationProfile.eligible ? `✓ Baseline calibrado: ${calibrationProfile.usableSampleCount} muestras` : `⚠ Baseline no elegible: ${calibrationProfile.caveats.join(', ')}`}
</p>
)}
{cameraError && <p className="error">Error de cámara: {cameraError}</p>}
{faceWorker.error && <p className="error">Error de MediaPipe: {faceWorker.error}</p>}
      </section>

      {isCameraActive ? (
        <Dashboard
          videoRef={videoRef} isCameraActive={isCameraActive} showMesh={showMesh} setShowMesh={setShowMesh}
          telemetry={telemetry} faceWorker={faceWorker} statusClassName={statusClassName} lastQuality={lastQuality}
          calibrationProfile={calibrationProfile} calStatusLabel={calStatusLabel}
          insightItems={insightItems} auEntries={auEntries} activeAUCount={activeAUCount}
          edgeAIResult={edgeAIResult} edgeChannels={edgeChannels} edgeConfidence={edgeConfidence} edgeComposite={edgeComposite}
          latestLandmarks={latestLandmarks} auRegionSummary={auRegionSummary}
          DEVICE_CONFIG={DEVICE_CONFIG}
        />
      ) : (
        <section className="grid-two">
          <article className="panel">
            <div className="panel-heading"><h2>1. Cámara y señal</h2></div>
            <div className="camera-container"><video ref={videoRef} className="camera" muted playsInline aria-label="Vista previa local de cámara" /></div>
            <p className="caption">Inicia la camara para comenzar la telemetría.</p>
          </article>
          <article className="panel">
            <p className="caption">Inicia la cámara para ver indicadores de microgestos.</p>
          </article>
        </section>
      )}
<section className="panel blendshape-panel">
<div className="panel-heading">
<div><h2>3. Gestos y Action Units</h2><p className="caption">Señales detectadas: AUs FACS, grupos de microgestos, blendshapes crudos.</p></div>
<span className={`status ${telemetry.recentCount ? 'ready' : ''}`}>{telemetry.recentCount ? `${activeAUCount} AUs activas · ${blendshapeNames.length} blendshapes` : 'sin datos'}</span>
</div>
{telemetry.recentCount ? (<>
<div className="tab-bar">
<button type="button" className={`tab ${activeTab === 'au' ? 'active' : ''}`} onClick={() => setActiveTab('au')}>AUs FACS ({activeAUCount})</button>
<button type="button" className={`tab ${activeTab === 'groups' ? 'active' : ''}`} onClick={() => setActiveTab('groups')}>Grupos microgestos</button>
<button type="button" className={`tab ${activeTab === 'blendshapes' ? 'active' : ''}`} onClick={() => setActiveTab('blendshapes')}>Blendshapes ({blendshapeNames.length})</button>
</div>
{activeTab === 'au' && (
<div className="au-panel">
<div className="au-region-summary">
{Object.entries(auRegionSummary).map(([region, score]) => (
<div className="au-region-card" key={region} style={{ borderColor: REGION_COLORS[region] }}>
<span className="region-label" style={{ color: REGION_COLORS[region] }}>{AU_REGIONS[region]?.label ?? region}</span>
<div className="region-bar-track"><div className="region-bar-fill" style={{ width: `${Math.round(clamp(score) * 100)}%`, background: REGION_COLORS[region] }} /></div>
<strong>{formatPercent(score)}</strong>
</div>
))}
</div>
<div className="au-grid">
{auEntries.map(([code, au]) => (
<div className="au-row" key={code}>
<div className="au-header">
<span className="au-code">{code}</span><span className="au-label">{au.label}</span>{au.note && <span className="au-note">{au.note}</span>}
</div>
<div className="au-bar-track"><div className="au-bar-fill" style={{ width: `${Math.round(clamp(au.intensity) * 100)}%`, background: REGION_COLORS[au.region] ?? 'var(--ink-blue)' }} /></div>
<strong className="au-intensity">{formatPercent(au.intensity)}</strong>
</div>
))}
</div>
</div>
)}
{activeTab === 'groups' && (
<div className="groups-panel">
<div className="groups-grid">
{mgEntries.map(([name, group]) => (
<div className="group-card" key={name}>
<span className="group-label">{group.label ?? name}</span>
<div className="group-bar-track"><div className="group-bar-fill" style={{ width: `${Math.round(clamp(group.avg) * 100)}%` }} /></div>
<strong>{formatPercent(group.avg)}</strong>
</div>
))}
</div>
</div>
)}
{activeTab === 'blendshapes' && (
<div className="blendshape-grid">
{blendshapeNames.map((name) => (
<div className="metric" key={name}><span>{name}</span><strong>{formatNumber(latestFaceSample?.blendshapes?.[name] ?? 0)}</strong></div>
))}
</div>
        )} </> : <p className="caption">Inicia la cámara para ver los gestos detectados por MediaPipe.</p>
      </section>

      {taskActive && (
        <section className="panel task-panel" style={{ scrollMarginTop: '80px' }}>
          <div className="panel-heading"><h2>🎯 Tarea de Reacción</h2></div>
          <SimpleRTTask
            active={taskActive}
            onTrialStart={handleTaskStart}
            onTrialEnd={handleTaskEnd}
            onComplete={handleTaskComplete}
            width={600}
            height={400}
          />
        </section>
      )}

      {edgeAIResult && (
<section className="panel edge-ai-panel">
<div className="panel-heading">
<div><h2>3.5 Edge AI Inference</h2><p className="caption">Modelo multidimensional client-side: 6 canales con evidencia explicable.</p></div>
<span className={`status ${edgeConfidence?.score > 0.7 ? 'ready' : ''}`}>{edgeConfidence?.level ?? '—'} · compuesto: {edgeComposite?.score ?? '—'}</span>
</div>
{edgeComposite && (
<div className="edge-composite-bar">
<span className="composite-label">Score compuesto</span>
<div className="composite-track"><div className="composite-fill" style={{ width: `${edgeComposite.score}%` }} /></div>
<strong>{edgeComposite.score}%</strong>
<span className={`composite-level ${edgeComposite.level}`}>{edgeComposite.level}</span>
</div>
)}
<div className="edge-channels-grid">
{Object.entries(edgeChannels).map(([name, channel]) => (
<div className="edge-channel-card" key={name} style={{ borderColor: CHANNEL_COLORS[name] ?? 'var(--ink-blue)' }}>
<div className="edge-channel-header">
<span className="edge-channel-label">{channel.label}</span>
<span className={`edge-channel-level ${channel.level}`}>{channel.level}</span>
</div>
<div className="edge-channel-bar-track"><div className="edge-channel-bar-fill" style={{ width: `${channel.score}%`, background: CHANNEL_COLORS[name] ?? 'var(--ink-blue)' }} /></div>
<div className="edge-channel-score-row"><strong>{channel.score}%</strong></div>
<p className="edge-channel-evidence">{channel.evidence}</p>
</div>
))}
</div>
{edgeConfidence && (
<div className="edge-confidence-detail">
<span className="caption">
Confianza: {edgeConfidence.level} ({(edgeConfidence.score * 100).toFixed(1)}%)
{' · '}Rostro: {formatPercent(edgeConfidence.factors?.facePresenceRatio ?? 0)}
{' · '}Detección: {formatNumber(edgeConfidence.factors?.detectionConfidence ?? 0, 2)}
{' · '}Calibrado: {edgeConfidence.factors?.calibrationEligible ? 'sí' : 'no'}
</span>
</div>
)}
{edgeAIResult.caveats?.length > 0 && (
<div className="edge-caveats">{edgeAIResult.caveats.map((c, i) => <p key={i} className="caption" style={{ color: 'var(--ink-yellow)' }}>⚠ {c}</p>)}</div>
)}
</section>
)}
{sessions.length > 0 && (
<section className="panel sessions-panel">
<div className="panel-heading">
<div><h2>4. Sesiones guardadas</h2><p className="caption">Historial de mediciones almacenadas localmente.</p></div>
<button type="button" className="secondary" onClick={() => { clearSessions(); setSessions([]); }} style={{ fontSize: '0.75rem', padding: '0.4rem 0.8rem' }}>Limpiar historial</button>
</div>
<div className="sessions-list">
{sessions.map((session) => (
<div className="session-row" key={session.id}>
<div className="session-meta">
<span className="session-date">{new Date(session.savedAt).toLocaleString('es-MX', { dateStyle: 'short', timeStyle: 'medium' })}</span>
<span className="session-duration">{session.durationMs ? `${(session.durationMs / 1000).toFixed(1)}s` : '—'}</span>
<span className="session-face-presence">Rostro: {formatPercent(session.facePresenceRatio)}</span>
{session.confidenceLevel && <span className={`session-confidence ${session.confidenceLevel}`}>Confianza: {session.confidenceLevel}</span>}
</div>
<div className="session-actions">
<button type="button" className="secondary" style={{ fontSize: '0.72rem', padding: '0.3rem 0.6rem' }} onClick={() => downloadJson(session.payload, `krumm-session-${session.id.slice(0, 8)}.json`)}>Descargar JSON</button>
</div>
</div>
))}
</div>
</section>
)}
</main>
);
}